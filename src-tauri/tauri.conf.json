{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC Album",
  "version": "1.2.0",
  "identifier": "com.axaka.vrchat-photo-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "VRC 相册", "width": 1200, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "axAKAbigSB",
    "shortDescription": "VRC 相册 — 按玩家整理本地 VRChat 照片",
    "longDescription": "VRC Album（VRC 相册）同步 VRChat 好友与 Gallery/Prints，并按精选好友整理本地照片。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
