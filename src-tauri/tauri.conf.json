{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC Album",
  "version": "0.1.0",
  "identifier": "com.axaka.vrchat-photo-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "VRC Album", "width": 1200, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "axAKAbigSB",
    "shortDescription": "按玩家整理本地 VRChat 照片",
    "longDescription": "读取 VRCX 玩家资料，分类浏览本地照片，并同步自己的 VRChat Gallery。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
