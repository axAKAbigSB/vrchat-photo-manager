{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRC Album",
  "version": "0.1.0",
  "identifier": "com.axaka.vrchat-photo-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "VRC Album", "width": 1200, "height": 760, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
